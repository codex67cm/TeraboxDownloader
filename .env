# ==============================
# Browser
# ==============================

# Chrome executable path. Leave empty for automatic detection.
CHROME_PATH=

# Chrome user data directory
CHROME_USER_DATA_DIR=

# Chrome profile to use
CHROME_PROFILE_DIRECTORY=Default

# Show Chrome window or run without a visible browser window
HEADLESS=true

# Prevent the automation browser from stealing Windows focus
FOCUS_WINDOW=false

# Keep the same browser session for the entire URL queue
PERSIST_BROWSER=true

# Reuse the same page/tab instead of opening a new one
REUSE_PAGE=true

# ==============================
# Downloads
# ==============================

# Directory where downloaded files are stored
OUTPUT_DIR=downloads

# Maximum time to wait for a download
DOWNLOAD_TIMEOUT=300

# Maximum time to wait for the generated TeraBox result
RESULT_TIMEOUT=60

# ==============================
# Timing
# ==============================

# Small delay after entering/pasting a URL
INPUT_SETTLE_DELAY=0.5

# Wait before clicking the final Download button
BUTTON_STABILIZATION_DELAY=1.0

# ==============================
# Retry
# ==============================

MAX_RETRIES=3

# ==============================
# Optional / Advanced
# ==============================

# Chrome Remote Debugging Port
CHROME_CDP_PORT=9222

# File containing TeraBox URLs (one per line)
URLS_FILE=urls.txt